      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:.5em;border:1px solid hsl(224,100%,85%);border-radius:999rem;background:hsl(224,100%,85%);color:hsl(224,10%,10%);font:1rem/1.1875 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Noto Sans',Arial,sans-serif;padding:.9375rem 1.25rem;text-decoration:none;outline-offset:.25rem}.ds-btn-primary:hover{color:hsl(224,10%,10%);filter:brightness(1.05)}.ds-btn-primary:focus-visible{outline:2px solid hsl(224,100%,60%)}"
